# Render Postgres internal connection URL in production.
DATABASE_URL=postgresql://user:password@localhost:5432/vape_mart
DATABASE_POOL_SIZE=10

# Generate a hash with: npm run admin:hash-password -- "your strong password"
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD_HASH=
SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional S3-compatible distributor product-image library. Banner uploads do not use S3.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Persistent product and banner image archive. Use a fine-grained token with Contents read/write
# access to this repository and a dedicated branch (for example, product-images).
GITHUB_IMAGE_ARCHIVE_TOKEN=
GITHUB_IMAGE_ARCHIVE_REPOSITORY=ChiragSavani1/vape-mart-website
GITHUB_IMAGE_ARCHIVE_BRANCH=product-images

RESEND_API_KEY=
EMAIL_FROM=Vape Mart <availability@yourdomain.ca>
AVAILABILITY_TO=vapemart307@gmail.com
RATE_LIMIT_SALT=replace-with-a-long-random-value
