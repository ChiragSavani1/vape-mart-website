# Comma-separated ChatGPT account emails allowed to administer the site.
ADMIN_EMAILS=owner@example.com

# Resend API key and a verified sender. Availability requests always go to vapemart307@gmail.com.
RESEND_API_KEY=
EMAIL_FROM=Vape Mart <availability@yourdomain.ca>
AVAILABILITY_TO=vapemart307@gmail.com

# Use a long random value in production to hash IP addresses for rate limiting.
RATE_LIMIT_SALT=replace-with-a-long-random-value
